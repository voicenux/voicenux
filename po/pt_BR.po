msgstr "Fones de ouvido"

msgid "Only for you, apps do not hear this."
msgstr "Só para você, os apps não ouvem isso."

msgid "Volume of the switch sounds"
msgstr "Volume dos sons de interruptor"

msgid "Test"
msgstr "Testar"

